# Copy to .env and fill in real values. Never commit .env with real secrets.

# ---- App / domain ----
DOMAIN=localhost
FRONTEND_HOST=http://localhost:5173
ENVIRONMENT=local
OPEN_REGISTRATION=true
JOBS_WORKER_ENABLED=true
PROJECT_NAME="FastAPI Stack"
STACK_NAME=fastapi-stack

# ---- API / auth ----
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173,https://localhost,https://localhost:5173"
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=changethis
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# ---- SMTP (sending emails) ----
# Only needed for email features (test email, notification sinks). Leave
# empty to disable email sending. Gmail example: smtp.gmail.com, 587, TLS,
# app password.
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# ---- Postgres ----
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis

# ---- Sentry (optional) ----
SENTRY_DSN=

# ---- MinIO (file storage) ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=fastapi-stack

# ---- Docker images ----
DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend
